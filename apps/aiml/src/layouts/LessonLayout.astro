---
import "@florilex/tutorial-kit/tokens.css";
import "../styles/theme.css";
import { stripTags } from "@florilex/tutorial-kit/stripTags";
import Sidebar from "../components/Sidebar.astro";
import SidebarInit from "../components/SidebarInit.astro";

interface Frontmatter {
  title: string;
  subtitle?: string;
  summary: string;
  phaseTitle: string;
  lessonNumber: number;
  hook?: string;
  hookCredit?: string;
  sourceUrl?: string;
}

interface Props {
  frontmatter: Frontmatter;
}

const { frontmatter } = Astro.props;
const lessonLabel = String(frontmatter.lessonNumber).padStart(2, "0");
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{stripTags(frontmatter.title)} — AI Engineering from Scratch</title>
    <SidebarInit />
  </head>
  <body>
    <div class="shell">
      <Sidebar currentPath={Astro.url.pathname} />
      <div class="page lesson-page">
        <div class="eyebrow">
          AI Engineering from Scratch <span class="dot">·</span> {frontmatter.phaseTitle}
          <span class="dot">·</span> Lesson {lessonLabel}
        </div>

        <h1 class="title" set:html={frontmatter.title} />

        {frontmatter.subtitle && <p class="subtitle" set:html={frontmatter.subtitle} />}

        {frontmatter.hook && (
          <div class="hook">
            <Fragment set:html={frontmatter.hook} />
            {frontmatter.hookCredit && <span class="credit">{frontmatter.hookCredit}</span>}
          </div>
        )}

        <section class="page-summary" aria-label="Summary">
          <h2 class="page-summary-title">Summary</h2>
          <p>{frontmatter.summary}</p>
        </section>

        <slot />

        <footer>
          {frontmatter.sourceUrl && (
            <>
              Based on the lesson outline for <em>"{stripTags(frontmatter.title)}"</em>, part of{" "}
              <a href={frontmatter.sourceUrl} target="_blank" rel="noopener">
                AI Engineering from Scratch
              </a>
              . This version expands each concept into worked explanations, original
              diagrams, and a self-contained exercise set.
            </>
          )}
        </footer>
      </div>
    </div>
  </body>
</html>
