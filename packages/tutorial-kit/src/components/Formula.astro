---
interface Props {
  name: string;
}
const { name } = Astro.props;
---
<div class="formula">
  <span class="name">{name}</span>
  <slot />
</div>

<style>
  .formula {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 1rem 1.3rem;
    margin: 1.2rem 0;
    font-family: ui-monospace, monospace;
    font-size: 1.02rem;
    color: var(--ink);
    max-width: 66ch;
    overflow-x: auto;
  }
  .formula .name {
    display: block;
    font-family: Seravek, sans-serif;
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
    margin-bottom: 0.5rem;
  }
</style>
