---
interface Props {
  label: string;
  variant?: "info" | "warn";
}
const { label, variant = "info" } = Astro.props;
---
<div class:list={["callout", { warn: variant === "warn" }]}>
  <span class="label">{label}</span>
  <slot />
</div>

<style>
  .callout {
    background: var(--accent2-soft);
    border-left: 3px solid var(--accent-2);
    border-radius: 4px;
    padding: 1rem 1.2rem;
    margin: 1.4rem 0;
    max-width: 66ch;
  }
  .callout .label {
    font-family: ui-monospace, monospace;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-2);
    margin-bottom: 0.4rem;
    display: block;
  }
  .callout :global(p:last-child) { margin-bottom: 0; }
  .callout.warn { background: var(--accent-soft); border-left-color: var(--accent); }
  .callout.warn .label { color: var(--accent); }
</style>
